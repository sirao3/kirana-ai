{
  "name": "kiranaai",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kiranaai/server dev",
    "dev:web": "pnpm --filter @kiranaai/web dev",
    "build": "pnpm --filter @kiranaai/web build && pnpm --filter @kiranaai/server build",
    "start": "pnpm --filter @kiranaai/server start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts",
    "e2e": "tsx scripts/e2e-demo.ts",
    "seed": "pnpm --filter @kiranaai/server seed",
    "db:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "~5.7",
    "vitest": "^3"
  }
}
