# Local development. Copy to .env (git-ignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Vertex AI instead of the key: GEMINI_VERTEX=1 + GOOGLE_CLOUD_PROJECT, after `gcloud auth application-default login`.
# On Vertex the transcribe model is GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live-preview.
# GEMINI_VERTEX=1
# GOOGLE_CLOUD_PROJECT=orbi-kirana-hack
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live-preview
DATABASE_URL=postgres://kiranaai:kiranaai@127.0.0.1:5433/kiranaai
ADMIN_PASSCODE=demo
PORT=8080
SELF_BASE_URL=http://127.0.0.1:8080
OFFER_WINDOW_SECONDS=45
