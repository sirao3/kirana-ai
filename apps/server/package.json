    "fastify": "^5",
    "pg": "^8",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "drizzle-kit": "^0.31",
    "google-auth-library": "10.9.1",
    "tsup": "^8"
  }
}
